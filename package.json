{
  "name": "dsh-git-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：把 git 常用操作接成工具（status / log / diff / show / blame / branch / add / commit / restore / stash / remote / sync，外加通用逃生口 git_run）。git 安装位置可配置（gitDir / gitPath），留空则跨平台自动探测，换机器不用改代码。零第三方依赖，全部命令走 argv 不经 shell。 | DSH plugin: git operations as tools, with a configurable Git installation directory.",
  "license": "MIT",
  "author": "defrg (https://github.com/defrg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defrg/dsh-git-plugin.git"
  },
  "homepage": "https://github.com/defrg/dsh-git-plugin#readme",
  "bugs": {
    "url": "https://github.com/defrg/dsh-git-plugin/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "check": "node scripts/check-git-path.mjs && node scripts/check-tools.mjs && node scripts/check-risk-ratchet.mjs",
    "check:git-path": "node scripts/check-git-path.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "check:risk": "node scripts/check-risk-ratchet.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./git": "./lib/git.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "git",
    "vcs",
    "version-control"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": "^22.15.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
